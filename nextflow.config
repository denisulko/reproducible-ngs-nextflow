/*
 * ============================================================================
 * Nextflow DSL2 Configuration: Reproducible Germline NGS Variant Calling
 * ============================================================================
 */

manifest {
    name            = 'denisulko/reproducible-ngs-nextflow'
    author          = 'Denis Ulko'
    homePage        = 'https://github.com/denisulko/reproducible-ngs-nextflow'
    description     = 'Production Nextflow DSL2 Pipeline for Germline Alignment, Variant Calling & MultiQC Telemetry'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=23.10.0'
    version         = '1.0.0'
}

params {
    input_samplesheet = "${projectDir}/data/raw/samplesheet.csv"
    fasta_ref         = "${projectDir}/data/ref/GRCh38.primary_assembly.fa"
    target_bed        = "${projectDir}/data/ref/twist_exome_targets_v2.bed"
    outdir            = "${projectDir}/results"

    // Clinical SLA / QC Gate Thresholds
    min_q30_pct       = 88.0
    min_mapped_pct    = 95.0
    max_dup_pct       = 15.0
    min_mean_cov      = 30.0
}

process {
    errorStrategy = { task.exitStatus in [137, 140, 143] ? 'retry' : 'finish' }
    maxRetries    = 2

    withLabel: 'process_low' {
        cpus   = 2
        memory = 4.GB
        time   = 1.h
    }
    withLabel: 'process_medium' {
        cpus   = 4
        memory = 12.GB
        time   = 3.h
    }
    withLabel: 'process_high' {
        cpus   = 8
        memory = 24.GB
        time   = 6.h
    }
}

profiles {
    standard {
        process.executor = 'local'
    }
    docker {
        docker.enabled   = true
        docker.runOptions = '-u $(id -u):$(id -g)'
        process.container = 'ghcr.io/denisulko/reproducible-ngs-nextflow:1.0.0'
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        process.container      = 'docker://ghcr.io/denisulko/reproducible-ngs-nextflow:1.0.0'
    }
    conda {
        conda.enabled = true
        process.conda = "${projectDir}/environment.yml"
    }
    slurm {
        process.executor       = 'slurm'
        process.queue          = 'genomics-compute'
        process.clusterOptions = '--account=clinical-biofx'
    }
    awsbatch {
        process.executor = 'awsbatch'
        process.queue    = 'nf-genomics-spot-queue'
        aws.region       = 'us-east-1'
    }
}

trace {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/execution_trace.txt"
    fields    = 'task_id,hash,native_id,process,tag,name,status,exit,module,container,cpus,time,disk,memory,attempt,submit,start,complete,duration,realtime,%cpu,%mem,rss,vmem,peak_rss,peak_vmem,rchar,wchar'
    overwrite = true
}

timeline {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/execution_timeline.html"
    overwrite = true
}

report {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/execution_report.html"
    overwrite = true
}

dag {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/pipeline_dag.svg"
    overwrite = true
}
